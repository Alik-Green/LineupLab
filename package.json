{
  "name": "lineuplab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["ui", "desktop", "mobile"],
  "scripts": {
    "dev": "npm run dev --workspace desktop",
    "dev:mobile": "npm run dev --workspace mobile",
    "build": "npm run build --workspace desktop",
    "build:mobile": "npm run build --workspace mobile",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p desktop/tsconfig.json && tsc --noEmit -p mobile/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tauri:desktop": "npm run tauri --workspace desktop",
    "tauri:mobile": "npm run tauri --workspace mobile",
    "pack": "cargo run -p lineuplab-core --bin lineuplab-pack --"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0",
    "jsdom": "^26.0.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/jest-dom": "^6.6.0"
  }
}
